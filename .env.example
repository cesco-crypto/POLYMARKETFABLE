# Nur für Live-Trading nötig. Kopiere nach .env (wird nie committet).
# ACHTUNG: Der private Schlüssel kontrolliert dein Geld. Niemals teilen.

# Private Key der Wallet (Polygon), die auf Polymarket handelt:
POLY_PRIVATE_KEY=

# Falls du über polymarket.com ein Konto erstellt hast (Proxy-Wallet):
# die Adresse, die dein USDC hält (im Profil sichtbar), und Signaturtyp 2.
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=2
