# Secrets — niemals committen!
.env
*.pem
*.key
config.yaml
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Laufzeitdaten (nur im Repo-Root — polybot/data/ ist Quellcode!)
/data/
/logs/
# temporäre Recorder-Logs/Helfer, kein Deliverable
/scratchpad_updown/
*.sqlite
*.db
paper_state.json
paper_state.fills.jsonl
paper_state.tmp
live_state.json
live_state.fills.jsonl
live_state.tmp

# OpenWiki-Laufzeitdateien (Wiki selbst wird committet)
openwiki/.env
openwiki/_plan.md

# Video-Produktion (video/) — Rohmaterial und Render-Zwischenstände nicht committen
video/input/*
!video/input/.gitkeep
video/projects/*/assets/source.mp4
video/projects/*/assets/source.*
video/projects/*/audio.*
video/projects/*/renders/
video/projects/*/snapshots/
video/projects/*/frames*/
video/projects/*/node_modules/
video/projects/*/.hyperframes/
video/projects/*/*.log

# Render-Master (unkomprimiert, nur lokal)
video/output/*-master.mp4
video/projects/*/assets/cut.mp4
